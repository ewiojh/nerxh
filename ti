local Rage = {}; Rage.__index = Rage
local function safeRequire(m) if not m then return nil end local ok, r = pcall(require, m); if ok then return r end return nil end
local function getCenter(cam) if not cam then return nil end return Vector2.new(cam.ViewportSize.X*0.5, cam.ViewportSize.Y*0.5) end

function Rage.new(context)
    local self = setmetatable({}, Rage)
    self.services = context.services; self.globals = context.globals
    self.cleaner = context.Cleaner.new(); self.errorHandler = context.errorHandler
    self.player = self.globals:GetPlayer()
    self.repStore = self.services.ReplicatedStorage; self.workspace = self.services.Workspace
    self.running = true; self._lastRcsTick = 0; self._rcsAccumulator = 0; self._lastRapidClick = 0
    self._weaponDefaults = {}; self._weaponTables = {}
    self.settings = {
        wallbang=false,wallbangToggleKey=Enum.KeyCode.Unknown,dynamicMiss=false,baseHitChance=100,
        aimlock=false,aimlockMode="手机按钮",aimlockHoldKey=Enum.UserInputType.MouseButton2,
        aimlockToggleKey=Enum.KeyCode.Unknown,aimlockMethod="Camera Lerp",aimlockFov=150,
        aimSmoothness=3,aimJitter=10,flickBot=false,targetPart="Head",randomPart=false,fullFov360=false,
        aimWallCheck=true,teamCheck=true,showFovCircle=false,fovSize=150,
        rapidFire=false,rapidFireDelay=50,rapidFireAutoClick=true,
        instantReload=false,instaEquip=false,autoClicker=false,autoClickDelay=50,
        rcs=false,rcsStrength=50,rcsDelay=0,
    }
    self.aimlockCircle = nil
    if Drawing and Drawing.new then
        local ok2, c2 = pcall(Drawing.new, "Circle")
        if ok2 and c2 and type(c2) ~= "number" then
            c2.Visible=false; c2.Color=Color3.fromRGB(120,200,255); c2.Thickness=1
            c2.Transparency=0.55; c2.NumSides=64; c2.Filled=false
            self.aimlockCircle = c2
            self.cleaner:Give(function() pcall(function() c2.Visible=false; c2:Remove() end) end)
        end
    end
    self:_bind(); return self
end

function Rage:_isActive() return self.running and self.globals:IsAlive() ~= nil end
function Rage:_getCamera() return self.globals:GetCamera() end
function Rage:_getAimCenter() return getCenter(self:_getCamera()) end

function Rage:_getTargetPart(model)
    if not model then return nil end
    local choice = self.settings.targetPart
    if self.settings.randomPart or choice == "Random Part" then
        local pool = {"Head","UpperTorso","LowerTorso"}
        choice = pool[math.random(1,#pool)]
    end
    return model:FindFirstChild(choice) or model:FindFirstChild("Head")
end

function Rage:_isTargetVisible(part, model)
    if self.settings.wallbang or not self.settings.aimWallCheck then return true end
    local cam = self:_getCamera(); if not cam or not part then return false end
    local origin = cam.CFrame.Position; local direction = part.Position - origin
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {cam}; local character = self.player and self.player.Character
    if character then ignore[#ignore+1] = character end
    local cf = self.workspace:FindFirstChild("Characters")
    if cf then
        for _, tf in ipairs(cf:GetChildren()) do
            for _, c in ipairs(tf:GetChildren()) do
                if c ~= model and c ~= character then ignore[#ignore+1] = c end
            end
        end
    end
    local debris = self.workspace:FindFirstChild("Debris"); if debris then ignore[#ignore+1] = debris end
    local viz = self.workspace:FindFirstChild("RaycastVisualizers"); if viz then ignore[#ignore+1] = viz end
    local attempts = 0
    while attempts < 15 do
        attempts = attempts + 1
        params.FilterDescendantsInstances = ignore
        local r = self.workspace:Raycast(origin, direction, params)
        if not r then return true end
        if r.Instance and r.Instance:IsDescendantOf(model) then return true end
        if r.Instance and (r.Instance.Transparency >= 0.5 or not r.Instance.CanCollide or tostring(r.Instance.Name):lower():find("hitbox",1,true) or r.Instance.Name == "Glass") then
            ignore[#ignore+1] = r.Instance
        else return false end
    end
    return false
end

function Rage:_getTargetData(maxFov)
    local cam = self:_getCamera(); local center = self:_getAimCenter()
    if not cam or not center then return nil end
    local best, bestScore = nil, tonumber(maxFov) or self.settings.aimlockFov or 150
    local characters = self.settings.teamCheck and self.globals:GetTargetModels(true) or self.globals:GetTargetModels(false)
    for _, model in ipairs(characters or {}) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local part = self:_getTargetPart(model)
            if part then
                local wp, onScreen = cam:WorldToViewportPoint(part.Position)
                if self.settings.fullFov360 or onScreen then
                    local score = self.settings.fullFov360 and (part.Position - cam.CFrame.Position).Magnitude or (Vector2.new(wp.X,wp.Y) - center).Magnitude
                    if score <= bestScore and self:_isTargetVisible(part, model) then
                        best = {model=model,part=part,pos=part.Position,score=score}
                        bestScore = score
                    end
                end
            end
        end
    end
    return best
end

function Rage:_applyAim(target, strengthScale)
    local cam = self:_getCamera(); local center = self:_getAimCenter()
    if not cam or not center or not target then return end
    local worldPos = target.pos or target.part.Position
    local vp = cam:WorldToViewportPoint(worldPos)
    local dx = vp.X - center.X
    local dy = vp.Y - center.Y
    local jitter = tonumber(self.settings.aimJitter) or 10
    dx = dx + ((math.random() - 0.5) * (jitter/100) * 2)
    dy = dy + ((math.random() - 0.5) * (jitter/100) * 2)
    local smooth = math.max(1, tonumber(self.settings.aimSmoothness) or 3)
    dx = (dx / smooth) * (strengthScale or 1)
    dy = (dy / smooth) * (strengthScale or 1)
    local sensitivity = 0.0025 * ((_G.MobileSensitivity or 25) / 25)
    local yaw = -dx * sensitivity
    local pitch = -dy * sensitivity
    local curPitch = math.asin(math.clamp(-cam.CFrame.LookVector.Y, -1, 1))
    local newPitch = math.clamp(curPitch + pitch, math.rad(-85), math.rad(85))
    local pitchDiff = newPitch - curPitch
    cam.CFrame = cam.CFrame * CFrame.Angles(pitchDiff, yaw, 0)
end

function Rage:_updateFovCircles()
    local cam = self:_getCamera(); local center = self:_getAimCenter()
    if not cam or not center then
        if self.aimlockCircle then self.aimlockCircle.Visible = false end
        return
    end
    if self.aimlockCircle then
        self.aimlockCircle.Visible = self.settings.aimlock
        if self.aimlockCircle.Visible then
            self.aimlockCircle.Position = center
            self.aimlockCircle.Radius = tonumber(self.settings.aimlockFov) or 150
        end
    end
end

function Rage:_findAllWeaponData()
    local found = {}
    if _hasGetgc then
        local ok, objects = pcall(getgc, true)
        if ok and type(objects) == "table" then
            for _, o in ipairs(objects) do
                if type(o) == "table" and type(rawget(o,"FireRate")) == "number" then found[o] = true end
            end
        end
    end
    local roots = {
        self.repStore:FindFirstChild("Weapons"),
        self.repStore:FindFirstChild("Assets") and self.repStore.Assets:FindFirstChild("Weapons"),
        self.repStore:FindFirstChild("Database") and self.repStore.Database:FindFirstChild("Weapons"),
    }
    for _, root in ipairs(roots) do
        if root then
            for _, item in ipairs(root:GetChildren()) do
                local mod
                if item:IsA("ModuleScript") then mod = item
                elseif item:IsA("Folder") then mod = item:FindFirstChild("Settings") or item:FindFirstChild("Data") or item:FindFirstChild("Config") end
                if mod and mod:IsA("ModuleScript") then
                    local r = safeRequire(mod)
                    if type(r) == "table" and type(rawget(r,"FireRate")) == "number" then found[r] = true end
                end
            end
        end
    end
    if _hasGetLoadedModules then
        local ok, mods = pcall(function() return getloadedmodules() end)
        if ok then
            for _, m in ipairs(mods) do
                if m:IsA("ModuleScript") and (m.Name:lower():find("weapon") or m.Name:lower():find("gun")) then
                    local r = safeRequire(m)
                    if type(r) == "table" and type(rawget(r,"FireRate")) == "number" then found[r] = true end
                end
            end
        end
    end
    return found
end

function Rage:_patchWeaponModules()
    local allData = self:_findAllWeaponData()
    for data in pairs(allData) do
        if not self._weaponTables[data] then
            self._weaponTables[data] = true
            self._weaponDefaults[data] = {
                ReloadTime=rawget(data,"ReloadTime"),ReloadSpeed=rawget(data,"ReloadSpeed"),
                FireRate=rawget(data,"FireRate"),Auto=rawget(data,"Auto"),
                EquipTime=rawget(data,"EquipTime"),DrawTime=rawget(data,"DrawTime"),DequipTime=rawget(data,"DequipTime"),
            }
        end
    end
    local function setF(t,k,v)
        if type(t) ~= "table" or rawget(t,k) == nil then return end
        if _hasSetreadonly then pcall(setreadonly,t,false) end
        pcall(function() rawset(t,k,v) end)
        if _hasSetreadonly then pcall(setreadonly,t,true) end
    end
    for data, d in pairs(self._weaponDefaults) do
        if self.settings.instantReload then setF(data,"ReloadTime",0); setF(data,"ReloadSpeed",999)
        else setF(data,"ReloadTime",d.ReloadTime); setF(data,"ReloadSpeed",d.ReloadSpeed) end
        if self.settings.rapidFire then
            local delay = (tonumber(self.settings.rapidFireDelay) or 50)/1000
            setF(data,"FireRate",math.max(delay,0.001))
        else setF(data,"FireRate",d.FireRate) end
        if self.settings.instaEquip then
            setF(data,"EquipTime",0); setF(data,"DrawTime",0); setF(data,"DequipTime",0)
        else
            setF(data,"EquipTime",d.EquipTime); setF(data,"DrawTime",d.DrawTime); setF(data,"DequipTime",d.DequipTime)
        end
        if self.settings.autoClicker then setF(data,"Auto",true); setF(data,"Automatic",true)
        else setF(data,"Auto",d.Auto) end
    end
end

function Rage:_processInstantActions()
    local char = self.player and self.player.Character; if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function()
                if self.settings.instaEquip then
                    if rawget(tool,"Equipped") == false then pcall(function() rawset(tool,"Equipped",true) end) end
                    local et = rawget(tool,"EquipTime") or rawget(tool,"DrawTime")
                    if et and type(et) == "number" then pcall(function() rawset(tool,"EquipTime",0); rawset(tool,"DrawTime",0) end) end
                end
                if self.settings.instantReload then
                    local rounds = rawget(tool,"Rounds"); local cap = rawget(tool,"Capacity")
                    if rounds and cap and type(rounds) == "number" and type(cap) == "number" then
                        if rounds < cap then pcall(function() rawset(tool,"Rounds",cap) end) end
                    end
                    if rawget(tool,"Reloading") == true then pcall(function() rawset(tool,"Reloading",false) end) end
                end
            end)
        end
    end
end

function Rage:_hookAnimator(animator)
    if not animator or not animator:IsA("Animator") then return end
    if animator:GetAttribute("RageWeaponAnimHooked") then return end
    animator:SetAttribute("RageWeaponAnimHooked", true)
    self.cleaner:Give(self.errorHandler:Connect(animator.AnimationPlayed, "Rage Weapon Animation", function(track)
        local anim = track and track.Animation; if not anim then return end
        local an = string.lower(anim.Name or ""); local ai = string.lower(anim.AnimationId or "")
        local function apply()
            if self.settings.instantReload and (an:find("reload") or ai:find("reload")) then
                pcall(function() track:AdjustSpeed(100) end)
                task.delay(0.05, function() if track.IsPlaying then pcall(function() track:Stop() end) end end); return
            end
            if self.settings.instaEquip and (an:find("equip") or an:find("draw") or ai:find("equip") or ai:find("draw")) then
                pcall(function() track:AdjustSpeed(100) end)
                task.delay(0.05, function() if track.IsPlaying then pcall(function() track:Stop() end) end end)
            end
        end
        self.cleaner:Give(self.errorHandler:Connect(track:GetPropertyChangedSignal("Speed"), "Anim Speed", apply))
        apply()
    end))
end

function Rage:_bindCharacter(character)
    if not character or character:GetAttribute("RageWeaponCharacterHooked") then return end
    character:SetAttribute("RageWeaponCharacterHooked", true)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Animator") then self:_hookAnimator(d) end
    end
end

function Rage:_updateAimlock(dt)
    if not self.settings.aimlock and not self.settings.flickBot then return end
    local shouldAim = false
    if self.settings.aimlockMode == "手机按钮" then
        shouldAim = _G.MobileAimHeld == true
    elseif self.settings.aimlockMode == "自动" then
        shouldAim = true
    elseif self.settings.aimlockMode == "热键" then
        local key = self.settings.aimlockHoldKey
        if typeof(key) == "EnumItem" then
            if key.EnumType == Enum.UserInputType then shouldAim = self.services.UserInputService:IsMouseButtonPressed(key)
            elseif key.EnumType == Enum.KeyCode then shouldAim = self.services.UserInputService:IsKeyDown(key) end
        end
    end
    if not shouldAim then return end
    local target = self:_getTargetData(self.settings.aimlockFov)
    if not target then return end
    if self.settings.aimWallCheck and not self.settings.wallbang then
        if not self:_isTargetVisible(target.part, target.model) then return end
    end
    self:_applyAim(target, 1)
end

function Rage:_updateRcs(dt)
    if not self.settings.rcs then self._rcsAccumulator = 0; self._lastRcsTick = 0; return end
    if not self.services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then self._rcsAccumulator = 0; self._lastRcsTick = 0; return end
    if self._lastRcsTick == 0 then self._lastRcsTick = tick(); return end
    local dm = tonumber(self.settings.rcsDelay) or 0
    if (tick() - self._lastRcsTick) < (dm/1000) then return end
    local s = tonumber(self.settings.rcsStrength) or 50
    self._rcsAccumulator = self._rcsAccumulator + (s*dt*0.8)
    if self._rcsAccumulator >= 1 then
        local amt = math.floor(self._rcsAccumulator); self._rcsAccumulator = self._rcsAccumulator - amt
        local cam = self:_getCamera()
        if cam then cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(-amt*0.1),0,0) end
    end
end

function Rage:_updateAutoClick()
    if self.settings.rapidFire and self.settings.rapidFireAutoClick then
        local fd = tonumber(self.settings.rapidFireDelay) or 50
        if not self.services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then self._lastRapidClick = 0; return end
        if self._lastRapidClick == 0 then self._lastRapidClick = tick(); return end
        if (tick() - self._lastRapidClick) < math.max(fd,1)/1000 then return end
        self._lastRapidClick = tick()
        if _hasMouse1click then pcall(mouse1click) end
    elseif self.settings.autoClicker then
        local fd = tonumber(self.settings.autoClickDelay) or 50
        if not self.services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then self._lastRapidClick = 0; return end
        if self._lastRapidClick == 0 then self._lastRapidClick = tick(); return end
        if (tick() - self._lastRapidClick) < math.max(fd,1)/1000 then return end
        self._lastRapidClick = tick()
        if _hasMouse1click then pcall(mouse1click) end
    else self._lastRapidClick = 0 end
end

function Rage:_bind()
    self.cleaner:Give(function() self.running = false end)
    if self.player then
        if self.player.Character then task.spawn(function() self:_bindCharacter(self.player.Character) end) end
        self.cleaner:Give(self.errorHandler:Connect(self.player.CharacterAdded, "Rage CharacterAdded", function(c) self:_bindCharacter(c) end))
    end
    self.errorHandler:Spawn("Rage Weapon Mods", function()
        while self.running do
            local need = self.settings.rapidFire or self.settings.instantReload or self.settings.instaEquip or self.settings.autoClicker
            if need then self:_patchWeaponModules() end
            task.wait(5 + math.random()*10)
        end
    end)
    self.cleaner:Give(self.errorHandler:Connect(self.services.RunService.RenderStepped, "Rage RenderStepped", function(dt)
        if not self:_isActive() then self:_updateFovCircles(); return end
        self:_updateFovCircles()
        self:_updateAimlock(dt or 0.016)
        self:_updateRcs(dt or 0.016)
        self:_updateAutoClick()
        self:_processInstantActions()
    end))
    self.cleaner:Give(self.errorHandler:Connect(self.services.UserInputService.InputBegan, "Rage InputBegan", function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if self.settings.wallbangToggleKey ~= Enum.KeyCode.Unknown and input.KeyCode == self.settings.wallbangToggleKey then self.settings.wallbang = not self.settings.wallbang
            elseif self.settings.aimlockToggleKey ~= Enum.KeyCode.Unknown and input.KeyCode == self.settings.aimlockToggleKey then self.settings.aimlock = not self.settings.aimlock end
        end
    end))
end

