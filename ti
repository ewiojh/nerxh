local wallCheckParams = RaycastParams.new()
wallCheckParams.FilterType = Enum.RaycastFilterType.Exclude
local IsVisible = function(p)
    if not p then return false end
    local c = player.Character; if not c then return false end
    local h = c:FindFirstChild("Head"); if not h then return false end
    local el = {c}; local cam = workspace.CurrentCamera; if cam then table.insert(el, cam) end
    wallCheckParams.FilterDescendantsInstances = el
