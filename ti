local lowGfxCache = {Materials={},Reflectances={},Textures={},GlobalShadows=nil}
local function ToggleLowGFX(enable)
    local Lighting = game:GetService("Lighting"); local WS = game:GetService("Workspace")
    if enable then
        lowGfxCache.GlobalShadows = Lighting.GlobalShadows; Lighting.GlobalShadows = false
        for _, v in ipairs(WS:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsDescendantOf(workspace.CurrentCamera) then
                lowGfxCache.Materials[v] = v.Material; lowGfxCache.Reflectances[v] = v.Reflectance
                v.Material = Enum.Material.SmoothPlastic; v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
                lowGfxCache.Textures[v] = v.Transparency; v.Transparency = 1
            end
        end
    else
        if lowGfxCache.GlobalShadows ~= nil then Lighting.GlobalShadows = lowGfxCache.GlobalShadows end
        for part, mat in pairs(lowGfxCache.Materials) do if part and part.Parent then part.Material = mat end end
        for part, ref in pairs(lowGfxCache.Reflectances) do if part and part.Parent then part.Reflectance = ref end end
        for decal, trans in pairs(lowGfxCache.Textures) do if decal and decal.Parent then decal.Transparency = trans end end
        table.clear(lowGfxCache.Materials); table.clear(lowGfxCache.Reflectances); table.clear(lowGfxCache.Textures)
    end
end

