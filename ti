        local vp = cam:WorldToViewportPoint(t.Position)
        local center = Vector2.new(cam.ViewportSize.X*0.5, cam.ViewportSize.Y*0.5)
        local dx = vp.X - center.X; local dy = vp.Y - center.Y
        local sens = 0.0025 * ((_G.MobileSensitivity or 25)/25)
        local yaw = -dx * sens / VisualAimbot.Smooth
        local pitch = -dy * sens / VisualAimbot.Smooth
        local curPitch = math.asin(math.clamp(-cam.CFrame.LookVector.Y, -1, 1))
        local newPitch = math.clamp(curPitch + pitch, math.rad(-85), math.rad(85))
        cam.CFrame = cam.CFrame * CFrame.Angles(newPitch - curPitch, yaw, 0)
    end
end)

